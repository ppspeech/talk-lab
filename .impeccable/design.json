  "components": [
    {
      "name": "Top bar with segmented sections",
      "kind": "nav",
      "refersTo": "bar",
      "description": "White bar: brand, client, Session/Plan/Progress segmented control, status.",
      "html": "<header class=\"ds-bar\"><span class=\"ds-brand\">Talk Lab</span><span class=\"ds-who\">Sam, 4;6</span><div class=\"ds-tabs\" role=\"tablist\"><button class=\"ds-tab\" role=\"tab\" aria-selected=\"true\"><svg class=\"ds-ic\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M3 12c3-4 6-5 9-3 3-2 6-1 9 3-3 4-6 6-9 6s-6-2-9-6Z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linejoin=\"round\"/></svg>Session<span class=\"ds-live\"></span></button><button class=\"ds-tab\" role=\"tab\" aria-selected=\"false\">Plan</button><button class=\"ds-tab\" role=\"tab\" aria-selected=\"false\">Progress</button></div></header>",
      "css": ".ds-bar{font-family:'Atkinson Hyperlegible',system-ui,sans-serif;display:flex;align-items:center;gap:12px;min-height:60px;padding:0 16px;background:#fff;border-bottom:1px solid #d6dbe1;color:#1b222b}.ds-brand{font-weight:700;font-size:18px}.ds-who{font-weight:700;flex:1}.ds-tabs{display:flex;gap:2px;background:#f3f5f7;border:1px solid #d6dbe1;border-radius:12px;padding:3px}.ds-tab{font-family:'Atkinson Hyperlegible',system-ui,sans-serif;display:flex;align-items:center;gap:6px;border:0;border-radius:9px;padding:8px 16px;min-height:40px;color:#56616d;font-weight:700;font-size:15px;background:transparent;cursor:pointer;transition:background-color .15s ease,color .15s ease}.ds-tab:hover{color:#1b222b}.ds-tab[aria-selected=true]{background:#1f3d7a;color:#fff}.ds-tab:focus-visible{outline:3px solid #1f3d7a;outline-offset:2px}.ds-ic{width:18px;height:18px}.ds-live{width:8px;height:8px;border-radius:50%;background:#23824f}"
    },
    {
      "name": "Phone bottom tab bar",
      "kind": "nav",
      "refersTo": "segmented-tabs",
      "description": "Below 760px the three sections become a fixed bottom bar, icon over label.",
      "html": "<nav class=\"ds-btabs\"><button class=\"ds-btab\" aria-selected=\"true\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M3 12c3-4 6-5 9-3 3-2 6-1 9 3-3 4-6 6-9 6s-6-2-9-6Z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/></svg>Session</button><button class=\"ds-btab\" aria-selected=\"false\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M5 19h4L19 9l-4-4L5 15z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/></svg>Plan</button><button class=\"ds-btab\" aria-selected=\"false\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m12 4 2.4 5 5.4.6-4 3.7 1.1 5.4L12 16l-4.9 2.7 1.1-5.4-4-3.7 5.4-.6z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/></svg>Progress</button></nav>",
      "css": ".ds-btabs{display:grid;grid-template-columns:repeat(3,1fr);gap:4px;padding:6px 8px;background:#fff;border-top:1px solid #d6dbe1;max-width:380px}.ds-btab{font-family:'Atkinson Hyperlegible',system-ui,sans-serif;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;min-height:52px;border:0;border-radius:9px;background:transparent;color:#56616d;font-weight:700;font-size:12px;cursor:pointer}.ds-btab svg{width:22px;height:22px}.ds-btab[aria-selected=true]{background:#1f3d7a;color:#fff}.ds-btab:focus-visible{outline:3px solid #1f3d7a;outline-offset:2px}"
    },
    {
      "name": "Goal deck cards",
      "kind": "card",
      "refersTo": "goal-card",
      "description": "Goal cards with a 6px goal-colour top edge; the current card lifts out of the deck.",
      "html": "<div class=\"ds-deck\"><div class=\"ds-gcard ds-cur\" style=\"--gc:#2f7fd8\"><b>Stage 4: CV</b><div class=\"ds-w\">bee · moo · two</div></div><div class=\"ds-gcard\" style=\"--gc:#e07b20\"><b>Stage 5: CVCV</b><div class=\"ds-w\">mummy · baby</div></div><div class=\"ds-gcard ds-off\" style=\"--gc:#2a9a5f\"><b>Final /p/</b><div class=\"ds-w\">up · cup</div></div><button class=\"ds-gadd\">Add goal</button></div>",
      "css": ".ds-deck{font-family:'Atkinson Hyperlegible',system-ui,sans-serif;display:flex;flex-direction:column;gap:10px;width:300px;padding:8px;background:#e8ebee;color:#1b222b}.ds-gcard{background:#fff;border:1px solid #d6dbe1;border-top:6px solid var(--gc);border-radius:12px;padding:12px;box-shadow:0 1px 2px rgba(27,34,43,.06);transition:transform .2s cubic-bezier(.2,.8,.3,1),box-shadow .2s ease;cursor:pointer}.ds-gcard:hover{box-shadow:0 6px 18px rgba(27,34,43,.14),0 1px 3px rgba(27,34,43,.08)}.ds-cur{transform:translateX(6px);box-shadow:0 6px 18px rgba(27,34,43,.14),0 1px 3px rgba(27,34,43,.08)}.ds-off{opacity:.62}.ds-w{color:#56616d;margin-top:4px}.ds-gadd{font-family:'Atkinson Hyperlegible',system-ui,sans-serif;min-height:56px;border:2px dashed #d6dbe1;background:transparent;border-radius:12px;color:#56616d;font-weight:700}@media (prefers-reduced-motion:reduce){.ds-gcard{transition:none}.ds-cur{transform:none}}"
    },
    {
      "name": "Word card",
      "kind": "custom",
      "refersTo": "word-card",
      "description": "Per-move practice card in the game; 10px top edge in the current goal's colour.",
      "html": "<div class=\"ds-word\" style=\"--gc:#2f7fd8\"><div class=\"ds-wd\">bee</div><div class=\"ds-acts\"><button class=\"ds-skip\">Skip</button><button class=\"ds-said\">Said it</button></div></div>",
      "css": ".ds-word{font-family:'Atkinson Hyperlegible',system-ui,sans-serif;width:280px;background:#fff;border:1px solid #d6dbe1;border-top:10px solid var(--gc,#1f3d7a);border-radius:20px;padding:20px;text-align:center;color:#1b222b;box-shadow:0 6px 18px rgba(27,34,43,.14),0 1px 3px rgba(27,34,43,.08)}.ds-wd{font-size:40px;font-weight:700;margin-bottom:16px}.ds-acts{display:flex;gap:8px;justify-content:center}.ds-skip,.ds-said{font-family:'Atkinson Hyperlegible',system-ui,sans-serif;min-height:40px;padding:8px 18px;border-radius:12px;font-weight:700;font-size:16px;cursor:pointer}.ds-skip{background:#fff;border:1px solid #d6dbe1;color:#1b222b}.ds-said{background:#1f3d7a;border:1px solid #1f3d7a;color:#fff}.ds-said:hover{background:#18305f}.ds-skip:focus-visible,.ds-said:focus-visible{outline:3px solid #1f3d7a;outline-offset:2px}"
    },
    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Ink-navy action with a drawn icon; one per area.",
      "html": "<button class=\"ds-btn\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m12 4 2.4 5 5.4.6-4 3.7 1.1 5.4L12 16l-4.9 2.7 1.1-5.4-4-3.7 5.4-.6z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linejoin=\"round\"/></svg>Finish session</button>",
      "css": ".ds-btn{font-family:'Atkinson Hyperlegible',system-ui,sans-serif;display:inline-flex;align-items:center;gap:6px;min-height:40px;padding:8px 16px;border-radius:12px;border:1px solid #1f3d7a;background:#1f3d7a;color:#fff;font-weight:700;font-size:15px;cursor:pointer}.ds-btn svg{width:18px;height:18px}.ds-btn:hover{background:#18305f}.ds-btn:focus-visible{outline:3px solid #1f3d7a;outline-offset:2px}"
    },
    {
      "name": "Chip button",
      "kind": "chip",
      "refersTo": "chip-button",
